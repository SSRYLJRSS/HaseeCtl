<UserControl x:Class="HaseeCtl.App.Pages.LightPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,8,4,4">
            <TextBlock Text="键盘灯" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                       Text="使用与官方软件相同的灯效与配色，Fn 快捷键依然可用。" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="开关与亮度" />
                    <CheckBox x:Name="EnableCheck" Content="开启键盘背光" Click="OnEnableChanged" Margin="0,0,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="亮度" Style="{StaticResource FieldLabel}" />
                        <Slider x:Name="BrightnessSlider" Width="260" Minimum="1" Maximum="4" IsSnapToTickEnabled="True"
                                TickFrequency="1" VerticalAlignment="Center" ValueChanged="OnBrightnessChanged" />
                        <TextBlock x:Name="BrightnessText" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="灯效" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="效果" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="EffectBox" Width="220" VerticalAlignment="Center" SelectionChanged="OnEffectChanged" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="「三区自定义」可以让左侧、中键区、右侧分别显示不同颜色。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="颜色预设" />
                    <WrapPanel x:Name="PresetPanel" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                        <TextBlock Text="左区" Style="{StaticResource FieldLabel}" MinWidth="48" />
                        <Border x:Name="LeftSwatch" Width="28" Height="20" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="中区" Style="{StaticResource FieldLabel}" MinWidth="48" Margin="16,0,12,0" />
                        <Border x:Name="MidSwatch" Width="28" Height="20" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="右区" Style="{StaticResource FieldLabel}" MinWidth="48" Margin="16,0,12,0" />
                        <Border x:Name="RightSwatch" Width="28" Height="20" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="点预设色应用到「当前区」；选择区：左 → 中 → 右 → 全部，点同一色可连续切换。" />
                    <WrapPanel Margin="0,10,0,0">
                        <RadioButton x:Name="ZoneLeft" Content="左区" GroupName="zone" IsChecked="True" Margin="0,0,14,8" />
                        <RadioButton x:Name="ZoneMid" Content="中区" GroupName="zone" Margin="0,0,14,8" />
                        <RadioButton x:Name="ZoneRight" Content="右区" GroupName="zone" Margin="0,0,14,8" />
                        <RadioButton x:Name="ZoneAll" Content="全部" GroupName="zone" Margin="0,0,14,8" />
                    </WrapPanel>
                    <Button Content="应用颜色" Click="OnApplyColors" Padding="18,7" HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
