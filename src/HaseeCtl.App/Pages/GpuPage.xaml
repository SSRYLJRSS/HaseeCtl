<UserControl x:Class="HaseeCtl.App.Pages.GpuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,8,4,4">
            <TextBlock Text="显卡模式" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                       Text="切换显卡输出模式需要重启生效。" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="当前模式" />
                    <TextBlock x:Name="CurrentText" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14" Text="—" />
                    <StackPanel x:Name="ModePanel" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="应用（稍后手动重启）" Click="OnApply" Padding="16,7" Margin="0,0,10,8" />
                        <Button Content="应用并立即重启" Click="OnApplyReboot" Padding="16,7" Margin="0,0,10,8" />
                    </WrapPanel>
                    <TextBlock x:Name="HintText" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="模式说明" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="独显直连：画面由 RTX 独显直接输出，延迟最低、性能最高，耗电大。&#10;混合模式：核显负责显示、独显按需渲染，省电，适合日常办公。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
