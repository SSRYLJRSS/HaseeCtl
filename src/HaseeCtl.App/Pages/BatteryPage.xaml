<UserControl x:Class="HaseeCtl.App.Pages.BatteryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,8,4,4">
            <TextBlock Text="电池充电" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                       Text="限制充电上限可以显著延长电池寿命，适合长期插电使用。" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="当前电池" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PercentText" Style="{StaticResource Metric}" Text="—" />
                        <TextBlock Style="{StaticResource MetricUnit}" Text="%" />
                        <TextBlock x:Name="AcText" VerticalAlignment="Bottom" Margin="16,0,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="充电上限" />
                    <CheckBox x:Name="EnableCheck" Content="启用充电上限" Click="OnEnableChanged" Margin="0,0,0,14" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="充到" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="StartBox" Width="110" VerticalAlignment="Center" SelectionChanged="OnSelectionChanged" />
                        <TextBlock Text="时停止，" Style="{StaticResource FieldLabel}" Margin="12,0,12,0" />
                        <ComboBox x:Name="StopBox" Width="110" VerticalAlignment="Center" SelectionChanged="OnSelectionChanged" />
                        <TextBlock Text="% 后继续放电" Style="{StaticResource FieldLabel}" Margin="12,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="应用" Click="OnApply" Padding="18,7" Margin="0,0,10,0" />
                        <Button Content="70 / 80 保养" Click="OnPreset7080" Padding="14,7" Margin="0,0,10,0" />
                        <Button Content="关闭上限（充到 100%）" Click="OnDisable" Padding="14,7" />
                    </StackPanel>

                    <TextBlock x:Name="HintText" Style="{StaticResource Hint}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="原理" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="上限由 EC 直接控制：电量达到停止值时切断充电，跌到起始值才重新充电。设置写入后掉电、重启都保持，官方软件卸载也不受影响。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
