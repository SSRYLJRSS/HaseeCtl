<UserControl x:Class="HaseeCtl.App.Pages.FanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:HaseeCtl.App.Controls">
    <UserControl.Resources>
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="18,7" Margin="0,0,8,0"
                                Background="Transparent" BorderBrush="#2E2E2E" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFF" />
                                <Setter Property="Foreground" Value="#0A0A0A" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8A8A8A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,8,4,4">
            <TextBlock Text="风扇控制" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                       Text="拖动曲线上的圆点即可调整：越往右越晚转、越往上越猛。起转点与满载点由固件固定，不可移动。" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="配置方案" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="ProfileBox" MinWidth="220" VerticalAlignment="Center"
                                  SelectionChanged="OnProfileChanged" />
                        <Button Content="应用此方案" Click="OnApplyProfile" Margin="10,0,0,0" Padding="14,6" />
                        <Button Content="保存修改" Click="OnSaveProfile" Margin="10,0,0,0" Padding="14,6" />
                        <Button Content="另存为…" Click="OnSaveAs" Margin="10,0,0,0" Padding="14,6" />
                        <Button Content="删除" Click="OnDeleteProfile" Margin="10,0,0,0" Padding="14,6" />
                    </StackPanel>
                    <TextBlock x:Name="ProfileHint" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource CardTitle}" Text="风扇曲线" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <RadioButton x:Name="CpuTab" Style="{StaticResource Segment}" Content="CPU" IsChecked="True"
                                     GroupName="CurveTarget" Checked="OnTargetChanged" />
                        <RadioButton x:Name="GpuTab" Style="{StaticResource Segment}" Content="GPU"
                                     GroupName="CurveTarget" Checked="OnTargetChanged" />
                    </StackPanel>

                    <ctl:FanCurveEditor x:Name="Curve" Height="300" Margin="0,6,0,0" />

                    <TextBlock x:Name="CurveInfo" Style="{StaticResource Hint}" Margin="2,12,0,0" />

                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="应用曲线（进入自定义）" Click="OnApplyCurve" Padding="16,7" Margin="0,0,10,8" />
                        <Button Content="只推送曲线不改模式" Click="OnPushOnly" Padding="16,7" Margin="0,0,10,8" />
                        <Button Content="GPU 抄 CPU" Click="OnCopyCpuToGpu" Padding="16,7" Margin="0,0,10,8" />
                        <Button Content="恢复出厂曲线" Click="OnRestoreDefaults" Padding="16,7" Margin="0,0,10,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="运行模式" />
                    <WrapPanel>
                        <Button Content="自动" Click="OnModeAuto" Padding="16,7" Margin="0,0,10,8" />
                        <Button Content="静音" Click="OnModeSilent" Padding="16,7" Margin="0,0,10,8" />
                        <Button Content="最大" Click="OnModeMax" Padding="16,7" Margin="0,0,10,8" />
                        <Button Content="全速 3 秒" Click="OnModeTurboBurst" Padding="16,7" Margin="0,0,10,8" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="「最大」会持续全速运行；「全速 3 秒」仅短暂拉高，随后回落到当前自定义曲线。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
