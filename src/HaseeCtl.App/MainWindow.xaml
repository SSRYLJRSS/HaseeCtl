<ui:FluentWindow x:Class="HaseeCtl.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="HaseeCtl 控制中心"
                 Icon="Assets/app.ico"
                 Width="1000" Height="720"
                 MinWidth="880" MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="HaseeCtl 控制中心" ShowMaximize="True" ShowMinimize="True" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Margin="10,0,6,10" Padding="6">
                <StackPanel>
                    <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="OnNavChanged" Margin="0,4,0,0"
                             ItemContainerStyle="{StaticResource NavItem}">
                        <ListBoxItem Content="概览" Tag="dashboard" />
                        <ListBoxItem Content="风扇控制" Tag="fan" />
                        <ListBoxItem Content="性能模式" Tag="performance" />
                        <ListBoxItem Content="电池充电" Tag="battery" />
                        <ListBoxItem Content="显卡模式" Tag="gpu" />
                        <ListBoxItem Content="键盘灯" Tag="light" />
                        <ListBoxItem Content="设置与关于" Tag="settings" />
                    </ListBox>
                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="8,8" />
                    <TextBlock Text="{Binding Status}" Margin="10,2" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ContentControl Grid.Column="1" x:Name="PageHost" Margin="6,0,10,10" />
        </Grid>
    </Grid>
</ui:FluentWindow>
